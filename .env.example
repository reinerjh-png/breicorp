# Remitente verificado en Resend, por ejemplo: BREICORP <noreply@breicorp.com.pe>
EMAIL_FROM=
EMAIL_TO=breicorp@gmail.com
RESEND_API_KEY=

# staging mantiene noindex; production habilita indexación, HSTS y CSP.
SITE_ENV=staging

# Medición opcional, sin PII
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
