# Normalize line endings for all text files automatically
* text=auto eol=lf

# Force LF for source files
*.tsx text eol=lf
*.ts  text eol=lf
*.css text eol=lf
*.js  text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.env* text eol=lf

# Binary files — never touch
*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.woff2 binary
*.woff  binary
